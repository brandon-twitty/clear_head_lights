rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isDealer() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dealer';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      allow update, delete: if isAdmin(); // Only admins can modify roles after creation
    }

    // Invites Collection
    match /invites/{inviteId} {
      allow read: if true; // Public can verify tokens
      allow create: if isAdmin();
      allow delete: if isAdmin() || request.auth != null; // New user can delete the token upon registration
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      // Admins can read/write all
      // Dealers can read/write their own
      allow read: if isAdmin() || (isDealer() && resource.data.dealerId == request.auth.uid);
      allow create: if isAdmin() || (isDealer() && request.resource.data.dealerId == request.auth.uid) || request.auth == null; // Allows public submissions
      allow update, delete: if isAdmin() || (isDealer() && resource.data.dealerId == request.auth.uid);
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isDealer() && resource.data.dealerId == request.auth.uid);
      allow write: if isAdmin(); // Only admins can create/update invoices
    }
    
    // Leads Collection
    match /leads/{leadId} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && request.resource.data.status == 'active');
      allow create: if true; // Public can submit leads
    }
  }
}
